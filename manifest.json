{
  "manifest_version": 3,
  "name": "Figma Screenshot Extension",
  "version": "1.7",
  "description": "Создание и экспорт скриншотов в Figma",
  "key": "djibiapnmmmkkjhmhcidbnnnnjjikebn",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://api.figma.com/*",
    "https://pgmarchenko.github.io/*"
  ],
  "oauth2": {
    "client_id": "TiuveWsSWiUY46CFhwAUL7",
    "scopes": ["files"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["oauth-callback.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://pgmarchenko.github.io/*"]
  }
} 